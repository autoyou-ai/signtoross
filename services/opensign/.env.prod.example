# Public OpenSign deployment template.
# Copy to .env.prod locally and fill real secrets. Do not commit .env.prod.

# Compose derives the server and browser URLs from HOST_URL in .env.
GENERATE_SOURCEMAP=false

REACT_APP_APPID=opensign
appName=OpenSign
MASTER_KEY=replace-with-opensign-parse-master-key
MONGODB_URI=mongodb://mongo:27017/OpenSignDB
# Caddy removes /api before forwarding requests to OpenSign.
PARSE_MOUNT=/app

DO_SPACE=
DO_ENDPOINT=
DO_BASEURL=
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=
USE_LOCAL=true

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER=
SMTP_ENABLE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER_EMAIL=admin@example.com
SMTP_USERNAME=admin@example.com
SMTP_PASS=replace-with-google-app-password

PFX_BASE64=
PASS_PHRASE=replace-with-pfx-passphrase-if-used
APP_ID=opensign
