PORT=3001
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL that OpenSign can call back through, for example a
# Cloudflare-routed Mike API host. Used to derive:
# <MIKE_PUBLIC_API_BASE_URL>/webhooks/signing/opensign
MIKE_PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_WEBHOOK_REQUIRED=false

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_HEALTH_TIMEOUT_MS=8000

# S3-compatible document storage. Use Cloudflare R2 in production or Supabase
# local storage for local development. For Supabase local storage, use:
# R2_ENDPOINT_URL=http://127.0.0.1:54321/storage/v1/s3
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Local model provider. For AutoYou-compatible mode, set AI_PROVIDER=ollama.
# For a Mike-only deployment, set OLLAMA_ENABLED=true. Explicit
# OLLAMA_ENABLED=false disables local models even when AI_PROVIDER=ollama.
# Set OLLAMA_MODEL to the exact model you pulled locally.
OLLAMA_ENABLED=false
# AI_PROVIDER=ollama
OLLAMA_API_BASE=http://127.0.0.1:11434
# OLLAMA_BASE_URL is also accepted as a Mike-specific alias.
OLLAMA_MODEL=ministral-3:8b
OLLAMA_CLOUD_FALLBACK=true
OLLAMA_FALLBACK_MODEL=gemini-3-flash-preview

# Optional AutoYou SignToROSS runtime probes. AutoYou admin defaults to port 8001,
# while the AI Agent /api/chat bridge defaults to port 8081.
AUTOYOU_ADMIN_API_BASE=http://127.0.0.1:8001
AUTOYOU_CHAT_API_BASE=http://127.0.0.1:8081
AUTOYOU_RUNTIME_REQUIRED=false
AUTOYOU_SIGNTOROSS_ADVICE_REQUIRED=false

RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Signing provider integration. OPENSIGN_API_BASE_URL should point to your
# OpenSign API base, for example https://sign.example.com/api/v1.2.
SIGNING_PROVIDER=opensign
OPENSIGN_API_MODE=token
OPENSIGN_API_BASE_URL=https://sign.example.com/api/v1.2
OPENSIGN_API_TOKEN=your-opensign-x-api-token
OPENSIGN_WEBHOOK_SECRET=your-opensign-webhook-security-key

# For Docker self-hosted OpenSign without paid API-token access, use:
# OPENSIGN_API_MODE=selfhost
# OPENSIGN_PARSE_BASE_URL=http://127.0.0.1:3051/api/app
# OPENSIGN_PUBLIC_URL=https://sign.example.com
# OPENSIGN_PARSE_HOST_HEADER=sign.example.com
# OPENSIGN_PARSE_APP_ID=opensign
# OPENSIGN_PARSE_MASTER_KEY=your-self-hosted-parse-master-key
# OPENSIGN_ADMIN_EMAIL=admin@example.com
# OPENSIGN_ADMIN_PASSWORD=your-local-opensign-admin-password
# OPENSIGN_SELFHOST_SEND_EMAIL=true
# OPENSIGN_SELFHOST_REQUIRE_EMAIL=false
# OPENSIGN_SELFHOST_EMAIL_CONFIGURED=false

# Optional controlled live test recipient for:
# LIVE_SIGNING_SEND=true npm run integration:opensign-live --prefix backend
LIVE_SIGNING_SEND=false
LIVE_SIGNING_TEST_EMAIL=you@example.com
LIVE_SIGNING_TEST_NAME=Mike Test Signer
LIVE_SIGNING_TEST_SUBJECT=Mike OpenSign integration probe
LIVE_SIGNING_PROVIDER_REQUEST_ID=
LIVE_SIGNING_REQUIRE_EMAIL=false

# Optional watcher for a Mike-created signature request:
# npm run integration:signature-watch --prefix backend -- --request-id <id> --watch
SIGNATURE_REQUEST_ID=
SIGNATURE_DOCUMENT_ID=
SIGNATURE_WATCH=false
SIGNATURE_SYNC_PROVIDER=false
SIGNATURE_WATCH_INTERVAL_MS=10000
SIGNATURE_WATCH_TIMEOUT_MS=600000
